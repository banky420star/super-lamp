# Broad runtime-ish at root level but only target known artifact patterns (avoid over-ignoring source csvs in docs/artifacts by using dir-specific where possible)
# runtime/*.csv etc already above; for top-level stray use caution + git add -f for legitimate like results_trend_bias.log (but prefer move to logs/)
# *.csv etc intentionally NOT blanket at root to preserve e.g. audit_xauusd_3000.csv , results.csv if source; they are covered by explicit lines above this file.

# Ensure .gitkeep files (for dir hygiene) are NOT ignored - these lock the folders runtime/, logs/, models/
!runtime/.gitkeep
!logs/.gitkeep
!models/.gitkeep
!**/.gitkeep

